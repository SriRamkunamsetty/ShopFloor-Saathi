# Copy to .env for local runs. Never commit real values.

# --- Runtime ---
SAATHI_ENV=development                 # development | production
SAATHI_AUTH_MODE=dev                   # dev (header roles, local only) | firebase (verify Firebase ID tokens)
SAATHI_REPO_BACKEND=json               # memory | json | firestore
SAATHI_DATA_DIR=./var

# --- Gemini (leave unset to run in deterministic offline mode) ---
SAATHI_LLM_ENABLED=false
# Option A: Gemini API key (local development)
# GOOGLE_API_KEY=...
# Option B: Vertex AI / Agent Platform (Cloud Run uses the service account, no key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Verify current model IDs before deploying; names change quickly.
SAATHI_FAST_MODEL=gemini-2.5-flash
SAATHI_PRO_MODEL=gemini-2.5-pro

# --- Business assumptions (shown to users, change to the plant's own numbers) ---
SAATHI_DOWNTIME_COST_INR_PER_HOUR=75000
SAATHI_ENERGY_TARIFF_INR_PER_KWH=8.5
SAATHI_GRID_EF_KG_PER_KWH=0.71         # verify against the latest CEA CO2 baseline database

# --- Hardening ---
SAATHI_RATE_LIMIT_PER_MINUTE=60
SAATHI_CORS_ORIGINS=                   # comma separated, empty = same-origin only
